rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the signed-in owner can read/write. Replace the email below with YOUR login email.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "PASTE_YOUR_LOGIN_EMAIL";
    }
  }
}
